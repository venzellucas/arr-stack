# Optional settings. Copy to .env and keep only the lines you change; without
# .env every value below is the default. Compose and the updater read .env.

# Time zone, and the user and group that own DATA_DIR.
TZ=Etc/UTC
PUID=1000
PGID=1000

# App configuration, and the one folder holding downloads and media.
CONFIG_DIR=/opt/appdata
DATA_DIR=/data

# qBittorrent's peer port (TCP and UDP). Pick your own rather than the default.
TORRENTING_PORT=6881

# Behind a reverse proxy: the host name browsers use for HolyArrs, and the
# proxy's address.
HOLYARRS_HOST=
REVERSE_PROXY=

# HolyArrs held-back features, comma separated, e.g. subtitle_sites.
HOLYARRS_FLAGS=

# Weekly image updates: uncomment to run the updater container (it uses the
# Docker socket). UPDATE_SCHEDULE is cron syntax, in TZ.
#COMPOSE_PROFILES=updater
UPDATE_SCHEDULE=0 5 * * 0

# Jellyfin hardware transcoding: uncomment both, with the group of
# /dev/dri/renderD128 (stat -c %g /dev/dri/renderD128).
#COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
#RENDER_GID=993
